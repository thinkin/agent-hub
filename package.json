{
  "name": "@evanginx/agent-hub",
  "version": "0.2.3",
  "description": "Agent Hub: a lightweight terminal workspace for local and remote coding agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thinkin/agent-hub.git"
  },
  "files": [
    "dist",
    "scripts/prepare-pty.mjs",
    "web/public/agent-hub-lockup-dark.png",
    "web/public/agent-hub-lockup-light.png"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "agent-hub": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-pty.mjs",
    "dev": "tsx src/cli.ts start --dev",
    "build": "tsc && vite build && node scripts/copy-assets.mjs",
    "prepack": "npm run build",
    "start": "node dist/cli.js start",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "express": "^5.1.0",
    "node-pty": "^1.1.0",
    "open": "^10.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
